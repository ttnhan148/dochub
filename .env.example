# ==============================================================================
# DocHub Environment Configuration Template
# Sao chép tệp này thành `.env` và điền các giá trị thích hợp trước khi chạy.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Ứng dụng & Xác thực (Single-user Auth)
# ------------------------------------------------------------------------------
APP_USERNAME=admin
# Tạo hash mật khẩu bằng script: `python scripts/hash_password.py <mat_khau>`
APP_PASSWORD_HASH=
# Khóa bí mật dùng để ký session cookie (tạo ngẫu nhiên một chuỗi dài an toàn)
SECRET_KEY=change_this_secret_key_to_a_random_secure_string

# ------------------------------------------------------------------------------
# 2. CORS & Port (Local Dev & Production)
# ------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# 3. Đường dẫn lưu trữ cục bộ (Local Storage & SQLite)
# ------------------------------------------------------------------------------
# Mặc định cho Local Dev (chạy từ thư mục backend/):
DB_PATH=../data/dochub.db
STORAGE_PATH=../data/storage
BACKUP_STAGING_PATH=../data/backups

# Cho Docker production (bỏ comment và thay thế các dòng trên khi chạy trong container):
# DB_PATH=/app/data/dochub.db
# STORAGE_PATH=/app/data/storage
# BACKUP_STAGING_PATH=/app/data/backups

# ------------------------------------------------------------------------------
# 4. Sao lưu từ xa (Azure Blob Storage - Chỉ dùng cho Backup định kỳ)
# ------------------------------------------------------------------------------
# Connection string của Azure Storage Account (nếu để trống, app vẫn chạy nhưng bỏ qua backup remote)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_BACKUP_CONTAINER=dochub-backups

# Lưu ý: Cấu hình AI (Azure AI Foundry BYOK) KHÔNG đặt ở đây.
# Người dùng sẽ nhập API Key và Endpoint trực tiếp trên giao diện Cài đặt (Settings UI).
